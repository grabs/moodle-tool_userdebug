{{!
    @template tool_userdebug/debuginfo

    Moodle template to display the settings.

    Classes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "manageurl": "https://www.example.com",
        "debugsettings": [
            {
                "key": "debug",
                "value": "32767"
            },
            {
                "key": "debugdeveloper",
                "value": "true"
            }
        ]
    }

}}
<div class="m-1">
    <div id="debugsettings-{{uniqid}}" class="collapse rounded p-1 bg-warning">
        <h4>{{#str}} debugactiv, tool_userdebug {{/str}}</h4>
        {{#manageurl}}
            <div class="m-1">
                <i class="fa fa-cog fa-fw"></i> <a href="{{.}}">{{#str}} settings {{/str}}</a>
            </div>
        {{/manageurl}}
        <div class="d-flex flex-column border-top p-1">
            {{#debugsettings}}
                <div class="settings-item">
                    <strong>{{key}}:</strong> <span>{{value}}</span>
                </div>
            {{/debugsettings}}
        </div>
    </div>
    <a id="tool-userdebug-toggle-button" href="#" class="float-end" data-bs-toggle="collapse" data-bs-target="#debugsettings-{{uniqid}}" aria-expanded="false" aria-controls="debugsettings-{{uniqid}}" title="{{#str}}adhocdebug, tool_userdebug, on {{/str}}">
        {{#pix}}debugon, tool_userdebug, {{#str}} debugactiv, tool_userdebug {{/str}} {{/pix}}
    </a>
</div>
